{
  "id": "bot-principal",
  "name": "Bot Principal",
  "profile": "C:/x/Akuma/configs/telegram_akuma.ini",
  "listener": {
    "enabled": false,
    "mode": "polling",
    "poll_timeout": 30,
    "allowed_updates": ["message"]
  },
  "reply_text": "Não incomode o Akuma",
  "totp": {
    "enabled": false,
    "profile": "C:/x/Akuma/configs/telegram_akuma.ini",
    "period_seconds": 30
  },
  "agent": {
    "enabled": true,
    "context": "akuma",
    "instructions": {
      "gateway_profile": "telegram-v1",
      "developer": "Mantenha a identidade, o comportamento e os objetivos do Akuma."
    }
  },
  "voice_transcription": {
    "enabled": true,
    "provider": "eccovox",
    "base_url": "http://127.0.0.1:8870",
    "request_timeout_seconds": 120,
    "queue_timeout_seconds": 180,
    "language": "pt-BR",
    "profile": "balanced",
    "max_audio_bytes": 10485760
  },
  "vault": {
    "profile": "vault/keepass.ini",
    "access": "read_write",
    "auth": {
      "mode": "windows_credential_manager",
      "target": "CREDENCIAL-DO-AKUMA"
    }
  }
}
